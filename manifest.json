{
  "manifest_version": 3,
  "name": "URL Saver for Supabase",
  "version": "1.0.0",
  "description": "Save the current tab's URL and title to your Supabase database with one click.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": ["https://*.supabase.co/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Save this page to Supabase",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
